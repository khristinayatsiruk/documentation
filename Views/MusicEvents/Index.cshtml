@model IEnumerable<MusicEventsApp.Models.MusicEvent>

@{ ViewData["Title"] = "Концертна афіша"; }

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-uppercase m-0"> Події</h1>
        <a asp-action="Create" class="btn btn-primary px-4 py-2">
            <i class="fas fa-plus mr-2"></i> Додати концерт
        </a>
    </div>

    @if (!Model.Any()) {
        <div class="alert alert-info bg-dark text-light border-0">Наразі немає запланованих подій.</div>
    } else {
        <table class="table table-dark table-striped">
            <thead>
                <tr>
                    <th>Назва</th>
                    <th>Виконавець</th>
                    <th>Місто</th>
                    <th>Ціна</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td class="font-weight-bold">@item.Title</td>
                        <td class="text-secondary">@item.Artist</td>
                        <td>@item.City</td>
                        <td class="text-primary font-weight-bold">@item.Price грн</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i> Edit
                            </a> 
                            
                            <a asp-action="Delete" asp-route-id="@item.Id" 
                               class="btn btn-sm btn-danger" 
                               onclick="return confirm('Ви впевнені, що хочете видалити цей концерт?')">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>